#!/bin/sh
# Rule R1: reject AI attribution. Logic lives in tools/fd/attribution.py. Fails closed.
command -v uv >/dev/null 2>&1 || { echo "fd: uv is not installed or not on PATH, so this commit is blocked (fail closed). Install uv, then run: uv run fd doctor" >&2; exit 1; }
exec uv run --quiet --project "$(dirname "$0")/../.." fd attribution-check commit-msg "$1"
