# Copy to .env and adjust. Never commit real secrets.
POSTGRES_USER=fairdrop
POSTGRES_PASSWORD=fairdrop
POSTGRES_DB=fairdrop
DATABASE_URL=postgresql+asyncpg://fairdrop:fairdrop@postgres:5432/fairdrop
REDIS_URL=redis://redis:6379/0

# Demo auth: SIM_MODE returns the OTP in the API response (no SMS provider).
SIM_MODE=true
# Used to HMAC phone numbers / OTPs. Change outside local demos.
SECRET_KEY=change-me-dev-only
ADMIN_API_KEY=admin-dev-key
SESSION_TTL_MINUTES=720
OTP_TTL_SECONDS=300
ADMISSION_TOKEN_TTL_SECONDS=300
